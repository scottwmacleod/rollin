{
  "name": "rollin-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "bun scripts/copy-tokens.mjs",
    "predev": "bun run prepare-assets",
    "dev": "bun --bun vite",
    "prebuild": "bun run prepare-assets",
    "build": "tsc --noEmit && bun --bun vite build && bun scripts/check-no-test-hooks.mjs",
    "preview": "bun --bun vite preview",
    "typecheck": "bun run prepare-assets && bun check --no-script",
    "typecheck:tsc": "bun run prepare-assets && tsc --noEmit",
    "e2e": "bun --bun playwright test",
    "e2e:changed": "bun -e \"process.exitCode = await (await import('./scripts/e2e-changed.ts')).main()\"",
    "build:e2e": "bun run prepare-assets && tsc --noEmit && bun --bun vite build --mode e2e --outDir dist-e2e"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@rollin/engine": "*",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.79.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
