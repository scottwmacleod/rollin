{
  "name": "rollin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/copy-tokens.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "tsc --noEmit && vite build && node scripts/check-no-test-hooks.mjs",
    "preview": "vite preview",
    "typecheck": "npm run prepare-assets && bun check --no-script",
    "typecheck:tsc": "npm run prepare-assets && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:e2e": "npm run prepare-assets && tsc --noEmit && vite build --mode e2e --outDir dist-e2e"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@rollin/engine": "*",
    "@ui-sdk/core": "0.1.0-beta.2",
    "@ui-sdk/react": "0.1.0-beta.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
