{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": ["./vendor/base/tooling/biome.base.json"],
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } },
    },
  ],
  "files": {
    "includes": [
      "packages/**",
      "apps/web/**",
      "ui/**",
      "!**/dist",
      "!**/dist-e2e",
      "!**/node_modules",
      "!**/playwright-report",
      "!**/test-results",
      "!apps/web/src/generated",
      "!packages/engine/fixtures",
    ],
  },
}
