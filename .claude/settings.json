    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push * :*)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Bash(git push * master)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh api *protection*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *-X *)",
      "Bash(gh api *--method*)",
      "Bash(cargo publish *)",
      "Bash(cargo login *)",
      "Bash(rm -rf *)"
    ]
  }
}
